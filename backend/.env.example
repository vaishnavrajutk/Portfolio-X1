PORT=8080
ALLOWED_ORIGINS=http://localhost:5173

# Leave SMTP_HOST/CONTACT_TO empty during local dev to just log contact
# messages to the console instead of sending real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
CONTACT_FROM=portfolio@example.com
CONTACT_TO=

CONTACT_RATE_LIMIT_PER_MIN=5
